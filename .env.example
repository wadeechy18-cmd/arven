# Supabase — from your project's Settings -> API page.
# NEXT_PUBLIC_* values are safe to ship to the browser (RLS protects them).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only secret. NEVER prefix this with NEXT_PUBLIC_, never import it
# into a Client Component, and never commit a real value. Used only by
# scripts/seed.ts and narrow trusted server code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional: Stripe (checkout falls back to "Pay on Delivery" if unset)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Store details
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_EMAIL="hello@arven.co"
NEXT_PUBLIC_STORE_PHONE="+1 (555) 010-2938"
