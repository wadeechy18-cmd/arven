# Copy to .env.local (local dev) or add in Vercel → Project → Settings → Environment Variables.

# Public site URL, used for SEO tags, sitemap and Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=https://daymark.ca

# Stripe (see README → "Turn on Stripe Checkout"). Leave blank until ready.
STRIPE_SECRET_KEY=

# Email via Resend (contact form + newsletter). See README → "Email: contact form & newsletter".
RESEND_API_KEY=
# Optional: where contact messages go (defaults to the email in data/site.ts)
CONTACT_TO_EMAIL=
# Optional: sender address, only after verifying your domain in Resend, e.g. Daymark <hello@daymark.ca>
CONTACT_FROM_EMAIL=
# Optional: Resend audience ID to collect newsletter subscribers
RESEND_AUDIENCE_ID=
